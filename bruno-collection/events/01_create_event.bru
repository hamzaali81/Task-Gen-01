meta {
  name: Create Event
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  x-workspace-id: {{workspaceId}}
}

body:json {
  {
    "title": "Annual Company Gala",
    "date": "2026-12-31T18:00:00.000Z",
    "currency": "USD"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("eventId", res.body.id);
  }
}

docs {
  Creates a new event in the workspace. Sets `eventId` for use in subsequent requests.
}
