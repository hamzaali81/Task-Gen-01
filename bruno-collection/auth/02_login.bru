meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "dev@example.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("token", res.body.access_token);
    bru.setVar("workspaceId", res.body.workspaces[0].id);
  }
}

docs {
  Logs in an existing user. Returns JWT and workspaces.
  Automatically sets `token` and `workspaceId`.
}
