meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "dev@example.com",
    "password": "password123",
    "firstName": "Dev",
    "lastName": "User"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("token", res.body.access_token);
    bru.setVar("workspaceId", res.body.workspaces[0].id);
  }
}

docs {
  Registers a new user and creates a default workspace.
  Automatically sets the `token` and `workspaceId` collection variables.
}
