meta {
  name: Approve Proposal
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/events/{{eventId}}/ai-chat/proposals/{{proposalId}}/approve
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  x-workspace-id: {{workspaceId}}
}

docs {
  Approves the pending proposal.
  - Budget items are written to the database
  - Proposal status is updated to "approved"
  - A Socket.IO `budgetUpdated` event is emitted to all clients in the workspace
  - The frontend budget table refreshes without a page reload
}
